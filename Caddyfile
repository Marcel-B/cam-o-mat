{
	admin off
	auto_https off
}

:8080 {
	encode gzip

	# Nur die lesenden go2rtc-Endpunkte freigeben (keine Konfig-Änderungen von außen)
	@go2rtc path /api/streams /api/stream.mjpeg /api/frame.jpeg
	handle @go2rtc {
		reverse_proxy 127.0.0.1:1984 {
			flush_interval -1
		}
	}

	# Kameras eintragen (Kamera hinzufügen) und Licht schalten: verwaltung.py
	@verwaltung path /api/kameras /cam/*/light
	handle @verwaltung {
		reverse_proxy 127.0.0.1:8081
	}

	# Firmware für "Kamera hinzufügen" nicht zwischenspeichern, damit nach einem Update die neue kommt
	header /firmware/* Cache-Control no-cache

	handle {
		root * /srv
		file_server
	}
}
