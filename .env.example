# Auth-Key aus https://login.tailscale.com/admin/settings/keys (einmalig nötig, danach bleibt der Login gespeichert)
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX

# Name im Tailnet (Seite: https://<name>.<tailnet>.ts.net)
TS_HOSTNAME=cam-o-mat

# Nur falls in der Kamera-Firmware Basic Auth aktiv ist: base64 von "benutzer:passwort"
#   echo -n 'benutzer:passwort' | base64
CAM_BASIC_AUTH=
